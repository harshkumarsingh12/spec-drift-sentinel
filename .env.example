# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Each team member should create their own keys: free limits are per account.

# Primary: NVIDIA Build (https://build.nvidia.com) — no card required
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Fallback on 429: Groq (https://console.groq.com) — no card required
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
