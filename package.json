{
  "name": "spec-drift-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Detects spec drift, diagnoses regression vs intentional contract change, and proposes human-ratified test updates.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sentinel": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "sentinel": "node --env-file-if-exists=.env dist/src/cli.js",
    "check:providers": "node --env-file-if-exists=.env scripts/check-providers.mjs",
    "postinstall": "node scripts/ensure-env.mjs && node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
